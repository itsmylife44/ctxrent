{
  "name": "ctxrent",
  "version": "0.1.1",
  "type": "module",
  "description": "Measure the context rent of coding-agent sessions and compare variants fairly",
  "license": "MIT",
  "keywords": [
    "ai",
    "agents",
    "context",
    "tokens",
    "profiler",
    "claude-code",
    "codex",
    "observability"
  ],
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "ctxrent": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "prepublishOnly": "npm test && npm run typecheck",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "version": "node scripts/version.js && git add skills/ctxrent/SKILL.md README.md"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsmylife44/ctxrent.git"
  },
  "bugs": {
    "url": "https://github.com/itsmylife44/ctxrent/issues"
  },
  "homepage": "https://github.com/itsmylife44/ctxrent#readme"
}
